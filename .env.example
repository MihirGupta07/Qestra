# API
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
API_AUTH_TOKEN=
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# MongoDB
# Leave blank for in-memory local development.
# Replace this later with your Atlas or local Mongo connection string.
MONGODB_URI=
MONGODB_DB=qestra_orchestrator

# Redis / BullMQ
# Leave blank until Redis is available.
REDIS_URL=

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption
# Use a long random value in production. Required to decrypt customer BYOK secrets after restarts.
ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Dashboard
WEB_PORT=4173
BACKEND_API_BASE=http://127.0.0.1:4000
