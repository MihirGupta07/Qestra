# --- API server ---
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
# Required in production; in dev, blank disables token auth so anything on
# localhost can hit the API.
API_AUTH_TOKEN=
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# --- Persistence ---
# Blank uses the in-memory repository (no setup required, lost on restart).
MONGODB_URI=
MONGODB_DB=qestra_orchestrator

# --- Queue ---
# Blank disables BullMQ and runs heartbeats inline.
REDIS_URL=

# --- LLM provider ---
# The dashboard "Provider Keys" panel writes to encrypted storage and is the
# preferred way to set a key. These env vars are only a fallback for when no
# stored key exists.
#
# LLM_PROVIDER: "mock" | "openai-compatible" | "anthropic"
# "openai-compatible" covers OpenAI itself, Groq, Nvidia NIM, Together,
# OpenRouter, Ollama, vLLM — anything speaking the OpenAI /v1 API.
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_BASE_URL=

# --- Secrets ---
# 32+ chars in production. Encrypts customer API keys at rest.
ENCRYPTION_SECRET=dev-only-change-me-before-production-pls

# --- Runtime ---
# Workspace dir for file.read / file.write / file.list. Created if missing.
QESTRA_WORKSPACE_DIR=./workspace
# Hard cap on LLM/tool iterations per execution.
QESTRA_MAX_RUNTIME_STEPS=6
# Seconds between auto-heartbeats. 0 = manual only (use the dashboard button).
QESTRA_AUTO_HEARTBEAT_SECONDS=0

# --- Tools ---
# Comma-separated executable names allowed for shell.exec. Empty disables the
# tool entirely. Example: git,ls,cat,echo,npm,node
QESTRA_SHELL_ALLOWLIST=
# Optional host allow/deny lists for http.fetch. Empty allow list = allow all
# public hosts. Private/loopback IPs are always blocked.
QESTRA_HTTP_ALLOW_HOSTS=
QESTRA_HTTP_DENY_HOSTS=

# --- Dashboard ---
WEB_PORT=4173
BACKEND_API_BASE=http://127.0.0.1:4000
