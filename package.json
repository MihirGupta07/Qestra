{
  "name": "qestra-orchestrator-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "A first vertical slice for a qestra-style multi-agent orchestration platform.",
  "scripts": {
    "start": "next dev apps/web -p 4173",
    "dev:web": "next dev apps/web -p 4173",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:worker": "tsx apps/workers/src/bullmq-worker.ts",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:full": "concurrently \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "build:web": "next build apps/web",
    "typecheck": "tsc --noEmit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "bullmq": "^5.65.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "lucide-react": "^1.14.0",
    "mongodb": "^6.20.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
