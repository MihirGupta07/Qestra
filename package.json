{
  "name": "qestra-orchestrator",
  "private": false,
  "version": "0.1.0",
  "description": "A governed multi-agent orchestration platform foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihirGupta07/Qestra.git"
  },
  "bugs": {
    "url": "https://github.com/MihirGupta07/Qestra/issues"
  },
  "homepage": "https://github.com/MihirGupta07/Qestra#readme",
  "keywords": [
    "ai-agents",
    "orchestration",
    "workflow",
    "governance",
    "llm",
    "bullmq",
    "mongodb",
    "nextjs",
    "fastify"
  ],
  "scripts": {
    "start": "npm run start:web",
    "dev:web": "next dev apps/web -p 4173",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:worker": "tsx apps/workers/src/bullmq-worker.ts",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:full": "concurrently \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "start:web": "next start apps/web -p 4173",
    "start:api": "tsx apps/api/src/index.ts",
    "start:worker": "tsx apps/workers/src/bullmq-worker.ts",
    "build:web": "next build apps/web",
    "vercel-build": "next build apps/web",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build:web",
    "typecheck": "tsc --noEmit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "bullmq": "^5.65.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "lucide-react": "^1.14.0",
    "mongodb": "^6.20.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
